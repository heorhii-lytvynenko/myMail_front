# Server-only origins: no /api suffix, path, query, or credentials.
# Production BACKEND_URL must be HTTPS and is required.
BACKEND_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# Keep false until the backend implements docs/backend-sync-prompt.md.
GOOGLE_INTEGRATION_ENABLED=false
BACKEND_LOGOUT_ENABLED=false

# Required only when Google integration is enabled. Generate 32 random bytes:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
GOOGLE_OAUTH_COOKIE_SECRET=
